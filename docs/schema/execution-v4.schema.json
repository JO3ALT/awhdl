{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWHDL execution, effect and approval checkpoint v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflow_run_id",
    "correlation_id",
    "generation",
    "records",
    "dataflow",
    "effects",
    "approvals"
  ],
  "properties": {
    "version": {
      "const": 4
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    },
    "dataflow": {
      "$ref": "#/$defs/dataflow"
    },
    "effects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/effect"
      }
    },
    "approvals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/approval"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "invocation_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_invocation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workflow_run_id",
        "invocation_id",
        "parent_invocation_id",
        "correlation_id",
        "generation",
        "attempt",
        "created_at",
        "causation_id"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {}
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {}
                }
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "result_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "payload"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "payload": {}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_run_id",
        "correlation_id",
        "generation"
      ],
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "revision",
        "payload"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "payload": {}
      }
    },
    "event_kind": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "topic"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "topic": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "revision"
          ],
          "properties": {
            "kind": {
              "const": "value_changed"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "invocation_id",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "invocation_terminated"
            },
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "enum": [
                "completed",
                "failed",
                "cancelled"
              ]
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "scope",
        "causation_id",
        "kind",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/event_kind"
        },
        "payload": {}
      }
    },
    "dataflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "events",
        "consumed"
      ],
      "properties": {
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "consumed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "scope",
        "operation",
        "action",
        "resource",
        "payload_hash",
        "class",
        "idempotency_key",
        "state",
        "requires_approval",
        "invocation_id",
        "result"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "class": {
          "enum": [
            "pure",
            "read",
            "local_write",
            "external_write",
            "destructive"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "not_started",
            "started",
            "confirmed",
            "failed",
            "uncertain"
          ]
        },
        "invocation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {}
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_approval": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_started"
              }
            }
          },
          "then": {
            "properties": {
              "invocation_id": {
                "type": "null"
              },
              "result": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "invocation_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {}
                }
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "effect_id",
        "scope",
        "action_hash",
        "content_hash",
        "capability",
        "resource",
        "class",
        "generation",
        "issued_at",
        "expires_at",
        "state",
        "decided_at",
        "consumed_by"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "effect_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "const": "single_action",
          "description": "transaction and time_limited_session are defined policy vocabulary but are not accepted by this runtime"
        },
        "action_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "local_write",
            "external_write",
            "destructive"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "pending",
            "granted",
            "denied",
            "consumed"
          ]
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "consumed_by": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "decided_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "decided_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "consumed"
              }
            }
          },
          "then": {
            "properties": {
              "consumed_by": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "else": {
            "properties": {
              "consumed_by": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
