{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWHDL execution identity checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflow_run_id",
    "correlation_id",
    "generation",
    "records"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "invocation_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_invocation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workflow_run_id",
        "invocation_id",
        "parent_invocation_id",
        "correlation_id",
        "generation",
        "attempt",
        "created_at"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "operation",
        "status"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "completed",
            "failed"
          ]
        }
      }
    },
    "result_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "payload"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "payload": {}
      }
    }
  }
}
