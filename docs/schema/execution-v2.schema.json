{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWHDL execution dataflow checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflow_run_id",
    "correlation_id",
    "generation",
    "records",
    "dataflow"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    },
    "dataflow": {
      "$ref": "#/$defs/dataflow"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "invocation_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_invocation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workflow_run_id",
        "invocation_id",
        "parent_invocation_id",
        "correlation_id",
        "generation",
        "attempt",
        "created_at",
        "causation_id"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {}
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {}
                }
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "result_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "payload"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "payload": {}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_run_id",
        "correlation_id",
        "generation"
      ],
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "revision",
        "payload"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "payload": {}
      }
    },
    "event_kind": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "topic"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "topic": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "revision"
          ],
          "properties": {
            "kind": {
              "const": "value_changed"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "invocation_id",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "invocation_terminated"
            },
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "enum": [
                "completed",
                "failed",
                "cancelled"
              ]
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "scope",
        "causation_id",
        "kind",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/event_kind"
        },
        "payload": {}
      }
    },
    "dataflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "events",
        "consumed"
      ],
      "properties": {
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "consumed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
